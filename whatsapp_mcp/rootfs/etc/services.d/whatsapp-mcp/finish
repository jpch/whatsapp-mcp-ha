#!/bin/sh
# Stop the container when the server exits with an error (e.g. an invalid auth_token) instead of
# restarting it in a loop. Home Assistant shows the error in the add-on log.
if [ "$1" -ne 0 ] && [ "$1" -ne 256 ]; then
  echo "$1" > /run/s6-linux-init-container-results/exitcode
fi
exec /run/s6/basedir/bin/halt
