#!/bin/sh
# Exit code 2 = invalid configuration: stop the add-on (the error is in the log) instead of restarting
# it in a loop. Any other exit is restarted by s6 after a short pause.
if [ "$1" -eq 2 ]; then
  echo 2 > /run/s6-linux-init-container-results/exitcode
  exec /run/s6/basedir/bin/halt
fi
if [ "$1" -ne 0 ] && [ "$1" -ne 256 ]; then
  sleep 5
fi
